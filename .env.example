# Copie para .env na raiz do repositório e defina as senhas locais.
# O modo demo usa 40 filmes reais com sinopses originais e dispensa chave.
# Pôsteres, fundos e trailers precisam de acesso à internet.
CATALOG_SOURCE=demo
# Para consultar o TMDB ao vivo: CATALOG_SOURCE=tmdb e uma chave de API v3 abaixo.
TMDB_API_KEY=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Opcional: porta local da interface. Padrão 5174 (Task Flow usa 5173).
WEB_PORT=5174
