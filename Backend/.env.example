DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=movie_catalog
CATALOG_SOURCE=demo
# O modo demo usa 40 filmes reais com sinopses originais e dispensa chave.
# Informe uma chave da API v3 somente com CATALOG_SOURCE=tmdb.
TMDB_API_KEY=

# A API sem autenticação aceita loopback. O Compose configura uma exceção
# para a rede interna dos contêineres sem publicar a porta da API no host.
HOST=127.0.0.1
PORT=3000
TMDB_TIMEOUT_MS=5000

# Opcional para chamadas diretas de outra origem. O proxy Vite não precisa de CORS.
# FRONTEND_ORIGIN=http://localhost:5173
